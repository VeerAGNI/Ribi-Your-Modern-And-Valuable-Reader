{
  "_INSTRUCTIONS": "Replace this entire file with your actual google-services.json from the Firebase Console.",
  "_STEPS": [
    "1. Go to https://console.firebase.google.com",
    "2. Select your project (or create one)",
    "3. Add an Android app with package name: com.veuros.ribi",
    "4. Download google-services.json",
    "5. Replace this file with the downloaded file",
    "6. Enable Authentication -> Google Sign-In in Firebase Console",
    "7. Enable Firestore Database in Firebase Console",
    "8. In strings.xml, set default_web_client_id to your OAuth 2.0 Web Client ID"
  ],
  "project_info": {
    "project_number": "YOUR_PROJECT_NUMBER",
    "project_id": "YOUR_PROJECT_ID",
    "storage_bucket": "YOUR_PROJECT_ID.appspot.com"
  },
  "client": [
    {
      "client_info": {
        "mobilesdk_app_id": "1:YOUR_PROJECT_NUMBER:android:YOUR_APP_HASH",
        "android_client_info": {
          "package_name": "com.veuros.ribi"
        }
      },
      "oauth_client": [
        {
          "client_id": "YOUR_WEB_CLIENT_ID.apps.googleusercontent.com",
          "client_type": 3
        }
      ],
      "api_key": [
        {
          "current_key": "YOUR_API_KEY"
        }
      ],
      "services": {
        "appinvite_service": {
          "other_platform_oauth_client": []
        }
      }
    }
  ],
  "configuration_version": "1"
}
